# =============================================================================
# AI QE Orchestrator — environment configuration
#
# Copy to `.env` and adjust. Every value here is read at startup; nothing in
# this file requires a code change to take effect.
#
# The defaults below run the entire platform with NO external services:
# deterministic mock LLM, local persistent Chroma, SQLite, simulated execution.
# =============================================================================

# ----- Mode ------------------------------------------------------------------
# The one switch that decides whether stand-ins are allowed.
#
#   local       Mocks permitted. Runs with no AI credentials, no Chroma, no
#               browser and no Jira: each degrades to a working stand-in and
#               logs a warning. This is the demo default.
#
#   production  No stand-ins. Every component must be able to do the real
#               thing, and the platform REFUSES TO START if one cannot --
#               naming what to set. Simulated test results presented as real
#               ones is the failure this prevents.
#
# Check what production would object to, before switching:
#   curl http://127.0.0.1:8100/api/v1/system/readiness
APP_MODE=local

# ----- Application -----------------------------------------------------------
APP_ENV=development
DEMO_MODE=true
LOG_LEVEL=INFO
LOG_JSON=false

# ----- Persistence -----------------------------------------------------------
# Leave DATABASE_URL unset to use SQLite at backend/data/aiqe.db (no server).
# Avoid a relative sqlite path here: it resolves against the directory the API
# starts in, which the demo scripts set to backend/.
# For PostgreSQL, use the DSN below — docker-compose sets exactly this.
# DATABASE_URL=postgresql+psycopg://qe:qe@postgres:5432/aiqe
DATABASE_ECHO=false

# Optional. Without it, background jobs run in an in-process thread pool.
# REDIS_URL=redis://redis:6379/0

# ----- Security --------------------------------------------------------------
# MUST be replaced with a long random value outside development.
JWT_SECRET=change-me-in-production-please-use-a-long-random-value
JWT_EXPIRY_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=600

# =============================================================================
# AI providers
#
# `mock` is deterministic and needs no credentials. Switching to a real
# provider is a change to DEFAULT_LLM_PROVIDER plus its credentials —
# agent definitions, flows and frontend code stay exactly as they are.
# =============================================================================

# mock | azure_openai | openai
DEFAULT_LLM_PROVIDER=mock
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ----- Azure OpenAI (primary enterprise provider) ----------------------------
# Deployment names are NOT model names; both are stored and used separately.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_REASONING_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# ----- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_REASONING_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# Chroma vector database (mandatory backing store for the Knowledge Fabric)
#
# Leave CHROMA_HOST empty for a local persistent client (demo default).
# Set CHROMA_HOST and CHROMA_PORT to use a Chroma server instead.
# =============================================================================
CHROMA_HOST=
CHROMA_PORT=
CHROMA_TENANT=
CHROMA_DATABASE=
# Unset = backend/data/chroma. Use an absolute path if you override it.
# CHROMA_PERSIST_DIRECTORY=

# Dimensions of the deterministic demo embedder. Real providers set their own
# (1536 for text-embedding-3-small); re-index after changing the provider.
EMBEDDING_DIMENSIONS=384

# ----- AWS Bedrock -----------------------------------------------------------
# Set DEFAULT_LLM_PROVIDER=bedrock to use it.
#
# There are deliberately no AWS keys here. boto3 resolves credentials through
# the standard chain -- environment, shared config, SSO, or the instance/task
# role -- so a deployment uses whatever its platform team already runs and no
# AWS secret is stored in this application or its database.
BEDROCK_REGION=
# Optional: a named profile from ~/.aws/config.
BEDROCK_PROFILE=
# Optional: a VPC endpoint or a gateway in front of Bedrock.
BEDROCK_ENDPOINT_URL=
#
# Model ids are configuration because they are account- and region-specific,
# and an inference profile ARN is equally valid here. Set the ids your account
# has access to; an unset slot advertises no model rather than one the platform
# cannot actually call.
BEDROCK_CHAT_MODEL=
BEDROCK_REASONING_MODEL=
BEDROCK_EMBEDDING_MODEL=

# ----- Execution -------------------------------------------------------------
# false  -> deterministic simulated execution driven by each test's history
# true   -> real Python Playwright (run `playwright install` first)
PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_HEADLESS=true
MAX_PARALLEL_WORKERS=4
PLAYWRIGHT_TIMEOUT_MS=8000

# ----- Evidence --------------------------------------------------------------
# What a real browser run captures when a test fails. This is what healing then
# reasons over, so turning a capture off makes healing less certain, by design.
CAPTURE_SCREENSHOT=true
CAPTURE_DOM_SNAPSHOT=true
CAPTURE_ACCESSIBILITY_TREE=true
CAPTURE_CONSOLE_LOGS=true
CAPTURE_NETWORK_LOGS=true
# Traces are the largest artefact; enable when someone actually replays them.
CAPTURE_TRACE=false
# Evidence older than this is deleted, files included. 0 keeps everything.
ARTIFACT_RETENTION_DAYS=30

# ----- Demo application under test -------------------------------------------
# A small checkout served at /demo-app so self-healing can be shown against a
# real browser and a real DOM. See backend/app/demo_app/README.md.
#   .../v1/checkout.html  the markup the tests were written against
#   .../v2/checkout.html  the same page after a redesign -- test ids renamed
DEMO_APP_ENABLED=true
DEMO_APP_BASE_URL=http://127.0.0.1:8100/demo-app/v2/checkout.html

# ----- Self-healing ----------------------------------------------------------
HEALING_ENABLED=true
# At or above this confidence a permitted change may skip human approval; it
# still has to survive its re-run.
HEALING_AUTO_APPLY_THRESHOLD=0.85
# Below this, a candidate is not worth putting in front of anyone.
HEALING_PROPOSE_THRESHOLD=0.50
# If the top two candidates are closer than this, the element is ambiguous and a
# human decides however confident the winner looked.
HEALING_AMBIGUITY_MARGIN=0.10
# A heal is only recorded as successful if a re-run proved it. Turning this off
# is a deliberate downgrade and is audited as one.
HEALING_REQUIRE_VALIDATION=true
HEALING_VALIDATE_ASYNC=false
HEALING_MAX_ATTEMPTS_PER_TEST=3
HEALING_MAX_WAIT_MS=15000
HEALING_MAX_RETRIES=2
# Override individual entries only; the rest keep their defaults. Assertions and
# business rules are "forbidden" by default and should stay that way.
# HEALING_CHANGE_POLICY={"test_data": "forbidden"}
# HEALING_CONFIDENCE_WEIGHTS={"historical_match": 0.25}

# ----- Governance and cost control -------------------------------------------
DEFAULT_PROJECT_COST_BUDGET_USD=50.0
DEFAULT_FLOW_COST_BUDGET_USD=5.0
DEFAULT_AGENT_TOKEN_BUDGET=40000
APPROVAL_REQUIRED_RISK_LEVELS=high,critical

# ----- Seeding ---------------------------------------------------------------
# Seeds the demo project on startup if the database is empty. Idempotent.
AUTO_SEED_ON_STARTUP=true
# Fixed seed makes the demo reproducible across resets.
SEED_RANDOM_STATE=20240917

# ----- Frontend --------------------------------------------------------------
# When frontend/dist exists (npm run build), the API also serves the web app,
# so the whole platform runs on one port. Set false to serve the API only.
SERVE_FRONTEND=true
# FRONTEND_DIST_DIR=
# Vite dev-server proxy target (npm run dev). Only needed if the API is not on 8000.
# VITE_API_TARGET=http://127.0.0.1:8000
